# ── 필수 ────────────────────────────────────────────────
# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── 선택 ────────────────────────────────────────────────
# 분류에 쓸 모델. 지정한 모델이 없으면 사용 가능한 최신 flash 모델로 자동 대체됩니다.
GEMINI_MODEL=gemini-3.6-flash
# 분류는 긴 추론이 필요 없어 기본 low. 분류 품질을 더 올리고 싶으면 high.
GEMINI_THINKING=low

# 분류 엔진 교체가 필요할 때만: gemini | openai | anthropic
# 어느 쪽을 골라도 쓰는 방법은 같습니다. 아래에서 해당 키만 채우면 됩니다.
# 모델명이 계정에 없으면 쓸 수 있는 최신 모델로 자동 대체됩니다.
LLM_PROVIDER=gemini

# LLM_PROVIDER=openai 일 때만 사용 (발급: https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# LLM_PROVIDER=anthropic 일 때만 사용 (발급: https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# 웹 UI 포트 / 로그인용 noVNC 포트
WEB_PORT=8080
VNC_PORT=6080

# 자동 수집 시각 (KST, 24시간제, 쉼표 구분). 하루 2회 기본값.
SYNC_TIMES=09:10,21:10

# 한 번 수집할 때 저장됨 목록을 최대 몇 개까지 훑을지 (0 = 제한 없음)
MAX_POSTS_PER_RUN=0

# 저장됨 목록 스크롤 관련
MAX_SCROLLS=400          # 최대 스크롤 횟수 (안전장치). 저장 글이 매우 많으면 늘리세요
SCROLL_PAUSE_MS=1400     # 스크롤 후 다음 묶음 로딩을 기다리는 시간. 느린 회선이면 2500
SCROLL_IDLE_ROUNDS=6     # 변화 없는 회차가 이만큼 연속되면 끝으로 간주

# 본문 이미지 로컬 저장 여부
DOWNLOAD_MEDIA=1

# 저장한 것이 '남의 글에 달린 댓글'이면 수집에서 제외 (원글만 모음)
SKIP_REPLIES=1

# ── 증분 수집 ──────────────────────────────────────────
# 저장됨 목록은 '최근 저장이 위'라서, 이미 가진 글이 연속으로 나오면 그 아래는 볼 필요가 없다.
INCREMENTAL=1
STOP_AFTER_KNOWN=1           # 이미 가진 글을 만나면 바로 중단 (1 = 첫 글에서 멈춤)
# 목록 응답의 thread_items 묶음을 신뢰 = 글마다 상세 페이지를 열지 않는다
TRUST_LIST_THREADS=1
# 0 = 어떤 경우에도 상세 페이지를 열지 않음 (최대 속도, 이어쓴 글 일부 포기)
FETCH_DETAIL=1
# 묶음을 못 받았을 때의 대체 판단 (본문 있고 댓글 0개면 열지 않음)
SKIP_DETAIL_WHEN_NO_REPLIES=1
INCREMENTAL_MIN_POSTS=30     # 최소 이만큼 모인 뒤부터 증분 적용
FULL_SWEEP_DAYS=7            # N일에 한 번은 끝까지 훑어 누락 확인

# 글 상세(본문 + 이어쓴 댓글) 수집 속도 — 저장 글이 수백 건이면 여기서 조절
DETAIL_SETTLE_MS=1800    # 상세 페이지 로딩 대기. 빠른 회선이면 1200까지 줄여도 됩니다
DETAIL_SCROLLS=3         # 상세 페이지 스크롤 횟수
DETAIL_PAUSE_MS=700      # 글 사이 간격 (너무 줄이면 계정 제한 위험)
DETAIL_TIMEOUT_SEC=60    # 글 1건이 이 시간을 넘기면 건너뜀
RECYCLE_EVERY=40         # N건마다 탭 재생성 (메모리 누적 방지)

# 멈춤 방지 안전장치
RUN_BUDGET_MIN=120       # 1회 실행 상한(분). 넘으면 저장된 것까지 두고 정상 종료 → 다음 실행에서 이어받음
RESPONSE_READ_SEC=15     # 응답 본문 읽기 상한
DRAIN_TIMEOUT_SEC=20     # 응답 파싱 마무리 대기 상한
STALE_JOB_MIN=15         # 이 시간 이상 소식 없는 '실행 중' 작업은 죽은 것으로 보고 정리
WATCHDOG_MIN=10          # 진행이 이만큼 멈추면 worker를 재시작해 스스로 복구 (0 = 끔)
MEDIA_TIMEOUT_SEC=90     # 글 1건의 이미지 저장 상한

# Threads 저장됨 페이지 주소 (바뀌면 여기만 수정)
SAVED_URL=https://www.threads.com/saved

# 데이터 경로 (컨테이너 기준)
DATA_DIR=/data
